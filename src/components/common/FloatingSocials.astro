---
interface Props {
  phone?: string;
  phoneDisplay?: string;
  whatsapp?: string;
  email?: string;
  instagram?: string;
  whatsappMessage?: string;
}

const { phone, whatsapp, email, instagram, whatsappMessage = "مرحبًا، أريد الاستفسار عن خدماتكم" } = Astro.props;
const encodedMessage = encodeURIComponent(whatsappMessage);
const items = [
  whatsapp && { label: "واتساب", href: `https://wa.me/${whatsapp}?text=${encodedMessage}`, external: true, icon: "wa" },
  phone && { label: "اتصال", href: `tel:${phone}`, external: false, icon: "phone" },
  instagram && { label: "إنستغرام", href: instagram, external: true, icon: "ig" },
  email && { label: "البريد", href: `mailto:${email}`, external: false, icon: "mail" },
].filter(Boolean) as { label: string; href: string; external: boolean; icon: string }[];
---

{
  items.length > 0 && (
    <nav class="floating-socials" aria-label="وسائل التواصل السريعة">
      {items.map((item) => (
        <a
          href={item.href}
          aria-label={item.label}
          title={item.label}
          target={item.external ? "_blank" : undefined}
          rel={item.external ? "noopener noreferrer" : undefined}
        >
          <span class="icon" aria-hidden="true">
            {item.icon === "wa" && <svg viewBox="0 0 24 24"><path d="M20.5 11.8a8.5 8.5 0 0 1-12.6 7.4L3 20.5l1.3-4.7a8.5 8.5 0 1 1 16.2-4Zm-8.4-6.1c-.3 0-.6 0-.8.5l-.9 2c-.1.3-.1.6.1.9.3.5.9 1.5 2.1 2.5 1.4 1.2 2.6 1.6 3.2 1.8.4.1.7 0 .9-.2l1.2-1.5c.2-.3.2-.6-.1-.7l-2.1-1c-.3-.1-.5-.1-.7.2l-.7.9c-.2.2-.4.2-.7.1-.7-.3-1.6-.8-2.4-1.7-.6-.7-1-1.4-1.2-1.9-.1-.3 0-.5.2-.7l.6-.7c.2-.2.3-.5.2-.8l-.9-2.2c-.1-.3-.4-.4-.6-.4Z" fill="currentColor"/></svg>}
            {item.icon === "phone" && <svg viewBox="0 0 24 24"><path d="M7.2 3.5 9.4 8c.2.4.1.8-.2 1.1l-1.5 1.5a15 15 0 0 0 5.7 5.7l1.5-1.5c.3-.3.7-.4 1.1-.2l4.5 2.2c.4.2.6.6.5 1l-.5 2.4c-.1.5-.5.8-1 .8C10.4 21 3 13.6 3 4.5c0-.5.3-.9.8-1l2.4-.5c.4-.1.8.1 1 .5Z" fill="currentColor"/></svg>}
            {item.icon === "ig" && <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>}
            {item.icon === "mail" && <svg viewBox="0 0 24 24"><path d="M3 6h18v12H3V6Zm1.5 1.5L12 13l7.5-5.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>}
          </span>
          <span class="label">{item.label}</span>
        </a>
      ))}
    </nav>
  )
}

<style>
  .floating-socials { position: fixed; left: 1rem; bottom: clamp(5.5rem, 18vh, 11rem); z-index: 1200; display: grid; gap: .55rem; pointer-events: auto; }
  .floating-socials a { display: flex; min-width: 46px; min-height: 46px; align-items: center; gap: .55rem; padding: .55rem .7rem; border: 1px solid rgb(255 255 255 / 70%); border-radius: 999px; background: rgb(255 255 255 / 94%); color: var(--color-text); box-shadow: 0 8px 24px rgb(32 26 18 / 14%); font-size: .82rem; font-weight: 800; touch-action: manipulation; backdrop-filter: blur(10px); }
  .floating-socials a:hover { transform: translateY(-2px); color: var(--color-primary); }
  .floating-socials .icon { display: grid; width: 27px; height: 27px; place-items: center; color: var(--color-primary); }
  .floating-socials svg { width: 23px; height: 23px; }
  @media (max-width: 640px) {
    .floating-socials { right: 0; bottom: 0; left: 0; display: flex; justify-content: space-around; gap: .35rem; padding: .55rem max(.55rem, env(safe-area-inset-right)) calc(.55rem + env(safe-area-inset-bottom)) max(.55rem, env(safe-area-inset-left)); border-top: 1px solid var(--color-border); background: rgb(255 255 255 / 96%); box-shadow: 0 -8px 28px rgb(32 26 18 / 12%); backdrop-filter: blur(12px); }
    .floating-socials a { min-width: 64px; min-height: 52px; flex: 1; flex-direction: column; justify-content: center; gap: .15rem; padding: .25rem .35rem; border: 0; border-radius: .7rem; background: transparent; box-shadow: none; }
    .floating-socials a:active { background: var(--color-primary-soft); transform: scale(.97); }
    .floating-socials .icon { width: 24px; height: 24px; }
    .floating-socials .label { font-size: .72rem; }
  }
</style>
