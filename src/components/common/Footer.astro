---
interface Props {
  siteName: string;
  footerText: string;
  description?: string;
  logo?: string;
  phone?: string;
  phoneDisplay?: string;
  whatsapp?: string;
  email?: string;
  address?: string;
  facebook?: string;
  instagram?: string;
  x?: string;
  youtube?: string;
}

const props = Astro.props;
const year = new Date().getFullYear();
const socialLinks = [
  { label: "فيسبوك", href: props.facebook },
  { label: "إنستغرام", href: props.instagram },
  { label: "منصة X", href: props.x },
  { label: "يوتيوب", href: props.youtube },
].filter((item): item is { label: string; href: string } => Boolean(item.href));
---

<footer class="site-footer">
  <div class="container footer-grid">
    <section class="footer-brand">
      <a class="footer-logo" href="/">
        {props.logo && <img src={props.logo} alt="" width="52" height="52" loading="lazy" />}
        <strong>{props.siteName}</strong>
      </a>
      {props.description && <p>{props.description}</p>}
      {socialLinks.length > 0 && <div class="social-links">{socialLinks.map((item) => <a href={item.href} target="_blank" rel="noopener noreferrer">{item.label}</a>)}</div>}
    </section>

    <section>
      <h2>روابط سريعة</h2>
      <nav class="footer-links" aria-label="روابط الفوتر">
        <a href="/">الرئيسية</a><a href="/about/">من نحن</a><a href="/services/">الخدمات</a><a href="/projects/">المشاريع</a><a href="/blog/">المقالات</a><a href="/contact/">تواصل معنا</a>
      </nav>
    </section>

    <section>
      <h2>خدماتنا</h2>
      <nav class="footer-links" aria-label="روابط الخدمات">
        <a href="/services/interior-paints/">دهانات داخلية</a>
        <a href="/services/exterior-paints/">دهانات خارجية</a>
        <a href="/services/decorations/">ديكورات</a>
        <a href="/services/gypsum/">جبسات وجبس بورد</a>
        <a href="/services/roof-insulation/">عوازل الأسطح</a>
      </nav>
    </section>

    <section>
      <h2>تواصل معنا</h2>
      <div class="contact-list">
        {props.phone && <a href={`tel:${props.phone}`}><strong>الهاتف</strong><span>{props.phoneDisplay || props.phone}</span></a>}
        {props.whatsapp && <a href={`https://wa.me/${props.whatsapp}`} target="_blank" rel="noopener noreferrer"><strong>واتساب</strong><span>{props.phoneDisplay || props.whatsapp}</span></a>}
        {props.email && <a href={`mailto:${props.email}`}><strong>البريد</strong><span>{props.email}</span></a>}
        {props.address && <div><strong>نطاق الخدمة</strong><span>{props.address}</span></div>}
      </div>
    </section>
  </div>

  <div class="container footer-bottom">
    <p>{props.footerText} © {year} {props.siteName}</p>
    <nav aria-label="الصفحات القانونية"><a href="/privacy/">سياسة الخصوصية</a><a href="/terms/">شروط الاستخدام</a></nav>
  </div>
</footer>

<style>
  .site-footer { margin-top: 4rem; padding-block: 4rem 1.5rem; border-top: 1px solid var(--color-border); background: var(--color-surface); }
  .footer-grid { display: grid; gap: 2.4rem; }
  .footer-brand { max-width: 470px; }
  .footer-logo { display: inline-flex; align-items: center; gap: .8rem; margin-bottom: 1rem; font-size: 1.1rem; }
  .footer-logo img { width: 48px; height: 48px; object-fit: contain; }
  .footer-brand p, .footer-links a, .contact-list span { color: var(--color-text-muted); }
  .site-footer h2 { margin-bottom: 1rem; font-size: 1.05rem; }
  .footer-links, .contact-list { display: grid; gap: .68rem; }
  .footer-links a { width: fit-content; }
  .footer-links a:hover { color: var(--color-primary); }
  .contact-list a, .contact-list div { display: grid; gap: .1rem; }
  .contact-list strong { font-size: .84rem; }
  .contact-list span { overflow-wrap: anywhere; }
  .social-links { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1.1rem; }
  .social-links a { padding: .35rem .7rem; border: 1px solid var(--color-border); border-radius: 999px; background: white; font-size: .82rem; font-weight: 700; }
  .footer-bottom { display: grid; gap: 1rem; margin-top: 3rem; padding-top: 1.4rem; border-top: 1px solid var(--color-border); color: var(--color-text-muted); font-size: .85rem; }
  .footer-bottom p { margin: 0; }
  .footer-bottom nav { display: flex; flex-wrap: wrap; gap: 1rem; }
  @media (min-width: 700px) { .footer-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .footer-bottom { grid-template-columns: 1fr auto; align-items: center; } }
  @media (min-width: 1050px) { .footer-grid { grid-template-columns: minmax(280px, 1.5fr) repeat(3, minmax(150px, 1fr)); } }
</style>
