---
interface Props {
  badge?: string;
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  primaryButtonText: string;
  primaryButtonUrl: string;
  secondaryButtonText?: string;
  secondaryButtonUrl?: string;
}

const {
  badge,
  title,
  description,
  image,
  imageAlt,
  primaryButtonText,
  primaryButtonUrl,
  secondaryButtonText,
  secondaryButtonUrl,
} = Astro.props;
---

<section class="hero">
  <div class="container hero__grid">
    <div class="hero__content">
      {badge && <span class="hero__badge"><span aria-hidden="true"></span>{badge}</span>}
      <h1>{title}</h1>
      <p>{description}</p>
      <div class="hero__actions">
        <a class="button button--primary" href={primaryButtonUrl}>{primaryButtonText}<span aria-hidden="true">←</span></a>
        {secondaryButtonText && secondaryButtonUrl && <a class="button button--secondary" href={secondaryButtonUrl}>{secondaryButtonText}</a>}
      </div>
      <ul class="hero__points" aria-label="مميزات الخدمة">
        <li>معاينة وتحديد نطاق العمل</li>
        <li>تنفيذ داخل جدة</li>
        <li>خدمات دهان وديكور متكاملة</li>
      </ul>
    </div>

    {image && <div class="hero__visual"><div class="hero__image-wrapper"><img src={image} alt={imageAlt || title} width="900" height="760" loading="eager" fetchpriority="high" decoding="async" /><div class="hero__floating-card"><strong>0506069197</strong><span>تواصل لتنسيق المعاينة</span></div></div></div>}
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; padding-block: clamp(3.5rem, 9vw, 7.5rem); background: radial-gradient(circle at 12% 20%, color-mix(in srgb, var(--color-primary) 12%, transparent), transparent 32%), linear-gradient(180deg, #fff, var(--color-surface)); }
  .hero::after { position: absolute; right: -12rem; bottom: -13rem; width: 32rem; height: 32rem; border-radius: 50%; background: color-mix(in srgb, var(--color-primary) 8%, transparent); content: ""; }
  .hero__grid { position: relative; z-index: 1; display: grid; gap: 2.8rem; align-items: center; }
  .hero__content { max-width: 780px; }
  .hero__badge { display: inline-flex; align-items: center; gap: .55rem; margin-bottom: 1rem; padding: .4rem .8rem; border: 1px solid var(--color-border); border-radius: 999px; background: rgb(255 255 255 / 85%); color: var(--color-primary-dark); font-size: .88rem; font-weight: 800; }
  .hero__badge > span { width: .55rem; height: .55rem; border-radius: 50%; background: var(--color-primary); box-shadow: 0 0 0 .25rem var(--color-primary-soft); }
  .hero h1 { max-width: 14ch; margin-bottom: 1.25rem; font-size: clamp(2.35rem, 8vw, 5.25rem); line-height: 1.13; letter-spacing: -.025em; text-wrap: balance; }
  .hero__content > p { max-width: 680px; margin-bottom: 1.6rem; color: var(--color-text-muted); font-size: clamp(1.02rem, 2.4vw, 1.22rem); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: .75rem; }
  .button { display: inline-flex; min-height: 52px; align-items: center; justify-content: center; gap: .55rem; padding-inline: 1.25rem; border-radius: var(--radius-md); font-weight: 850; }
  .button--primary { background: var(--color-primary); color: white; box-shadow: 0 10px 25px color-mix(in srgb, var(--color-primary) 25%, transparent); }
  .button--secondary { border: 1px solid var(--color-border); background: white; color: var(--color-text); }
  .hero__points { display: flex; flex-wrap: wrap; gap: .55rem 1.2rem; margin: 1.4rem 0 0; padding: 0; list-style: none; color: var(--color-text-muted); font-size: .88rem; font-weight: 700; }
  .hero__points li::before { margin-inline-end: .4rem; color: var(--color-primary); content: "✓"; }
  .hero__visual { min-width: 0; }
  .hero__image-wrapper { position: relative; overflow: hidden; border: 1px solid var(--color-border); border-radius: 2rem; background: white; box-shadow: var(--shadow-md); }
  .hero__image-wrapper img { width: 100%; aspect-ratio: 6 / 5; object-fit: cover; }
  .hero__floating-card { position: absolute; right: 1rem; bottom: 1rem; display: grid; gap: .1rem; padding: .9rem 1rem; border: 1px solid rgb(255 255 255 / 75%); border-radius: var(--radius-md); background: rgb(255 255 255 / 93%); box-shadow: var(--shadow-md); backdrop-filter: blur(10px); }
  .hero__floating-card strong { color: var(--color-primary-dark); direction: ltr; }
  .hero__floating-card span { color: var(--color-text-muted); font-size: .78rem; }
  @media (min-width: 930px) { .hero__grid { grid-template-columns: minmax(0, 1.05fr) minmax(390px, .95fr); gap: clamp(3rem, 6vw, 6rem); } }
  @media (max-width: 520px) { .hero__actions .button { width: 100%; } .hero h1 { font-size: clamp(2.2rem, 12vw, 3.1rem); } }
</style>
