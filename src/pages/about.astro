---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/common/PageHero.astro";
import PostContactButtons from "../components/blog/PostContactButtons.astro";
const entry = await getEntry("settings", "site");
if (!entry) throw new Error("ملف إعدادات الموقع غير موجود");
const settings = entry.data;
---
<BaseLayout title="من نحن" description="تعرف على طريقة عمل ديكورات ودهانات جدة في معاينة المواقع وتجهيز الأسطح وتنفيذ الدهانات والديكورات والتشطيبات." image={settings.aboutImage} imageAlt={settings.aboutImageAlt} pageType="AboutPage">
  <main id="main-content">
    <PageHero eyebrow="من نحن" title="خدمات دهانات وديكور تبدأ بالتخطيط الجيد" description="نخدم المنازل والفلل والمنشآت في جدة بحلول متكاملة للدهانات والديكورات والتشطيبات." image={settings.aboutImage} imageAlt={settings.aboutImageAlt} />
    <section class="section"><div class="container about-layout"><article class="prose"><h2>كيف نعمل؟</h2><p>تبدأ الخدمة بمعرفة نوع الموقع وحالته والخدمة المطلوبة. بعد المعاينة نحدد أعمال التجهيز، ونقترح الخامات والألوان والتشطيبات المناسبة، ثم نرتب مراحل التنفيذ بما يقلل التعارض بين الدهان والجبس والديكورات والعزل.</p><h2>ما الذي نهتم به؟</h2><p>نهتم بتجهيز الجدران قبل الدهان، ومعالجة الشقوق والرطوبة من مصدرها، وحماية الأرضيات والأثاث، وضبط تفاصيل القصّات والفواصل، وتنظيف الموقع بعد انتهاء العمل.</p><h2>نطاق خدماتنا</h2><p>تشمل خدماتنا الدهانات الداخلية والخارجية، الديكورات، ورق الجدران، الجبسات والجبس بورد، الترميمات، الإيبوكسيات، عوازل الأسطح، والمظلات والسواتر والبرجولات داخل جدة.</p></article><aside><h2>مبادئ التنفيذ</h2><ul>{settings.aboutFeatures.map((feature) => <li><span aria-hidden="true">✓</span>{feature}</li>)}</ul></aside></div><div class="container"><PostContactButtons phone={settings.phone} phoneDisplay={settings.phoneDisplay} whatsapp={settings.whatsapp} title="ناقش معنا مشروعك في جدة" whatsappMessage="مرحبًا، أريد الاستفسار عن طريقة العمل وخدمات الدهانات والديكور" /></div></section>
  </main>
</BaseLayout>
<style>
  .about-layout { display: grid; gap: 2.5rem; align-items: start; }
  aside { padding: 1.5rem; border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); }
  aside h2 { font-size: 1.35rem; }
  aside ul { display: grid; gap: .7rem; padding: 0; list-style: none; }
  aside li { display: flex; gap: .55rem; font-weight: 700; }
  aside li span { color: var(--color-primary-dark); }
  @media (min-width: 900px) { .about-layout { grid-template-columns: minmax(0, 1.25fr) minmax(300px, .75fr); } }
</style>
