---
import { getCollection, getEntry } from "astro:content";
import SeoAdminLayout from "../../layouts/SeoAdminLayout.astro";

type ContentKind = "مقال" | "خدمة" | "مشروع";

type AuditItem = {
  kind: ContentKind;
  title: string;
  path: string;
  score: number;
  draft: boolean;
  warnings: string[];
  seoTitleLength: number;
  descriptionLength: number;
};

type AuditSource = {
  kind: ContentKind;
  title: string;
  description: string;
  seoTitle?: string;
  seoDescription?: string;
  image?: string;
  imageAlt?: string;
  terms?: string[];
  body?: string;
  updatedDate?: Date;
  faqCount?: number;
  draft: boolean;
  path: string;
  supportsUpdatedDate?: boolean;
  supportsFaq?: boolean;
};

const settingsEntry = await getEntry("settings", "site");
if (!settingsEntry) throw new Error("ملف إعدادات الموقع غير موجود");
const settings = settingsEntry.data;

const productionUrl = (Astro.site?.toString() ?? settings.siteUrl).replace(/\/+$/, "");
const hostname = new URL(productionUrl).hostname;

const blogEntries = await getCollection("blog");
const serviceEntries = await getCollection("services");
const projectEntries = await getCollection("projects");

const cleanBody = (value?: string) =>
  (value ?? "")
    .replace(/^---[\s\S]*?---/u, "")
    .replace(/[#*_>`\[\]()!-]/gu, " ")
    .replace(/\s+/gu, " ")
    .trim();

const bodyOf = (entry: unknown) => {
  if (typeof entry !== "object" || entry === null || !("body" in entry)) return "";
  const body = (entry as { body?: unknown }).body;
  return typeof body === "string" ? body : "";
};

function createAudit(source: AuditSource): AuditItem {
  const seoTitle = (source.seoTitle || source.title).trim();
  const seoDescription = (source.seoDescription || source.description).trim();
  const bodyLength = cleanBody(source.body).length;
  const warnings: string[] = [];

  let earned = 0;
  let possible = 0;

  const addCheck = (weight: number, passed: boolean, warning: string, partial = false) => {
    possible += weight;
    if (passed) {
      earned += weight;
      return;
    }

    if (partial) earned += Math.round(weight / 2);
    warnings.push(warning);
  };

  addCheck(
    18,
    seoTitle.length >= 30 && seoTitle.length <= 65,
    seoTitle.length < 30 ? "عنوان SEO قصير" : "عنوان SEO أطول من الموصى به",
    seoTitle.length >= 20 && seoTitle.length <= 75,
  );

  addCheck(
    22,
    seoDescription.length >= 80 && seoDescription.length <= 165,
    seoDescription.length < 80 ? "وصف SEO قصير" : "وصف SEO أطول من الموصى به",
    seoDescription.length >= 55 && seoDescription.length <= 190,
  );

  addCheck(10, Boolean(source.image), "لا توجد صورة رئيسية");
  addCheck(10, Boolean(source.imageAlt?.trim()), "النص البديل للصورة غير موجود");
  addCheck(10, Boolean(source.terms && source.terms.length >= 2), "أضف كلمات أو وسومًا مرتبطة بالموضوع");
  addCheck(18, bodyLength >= 700, "المحتوى يحتاج إلى تفاصيل أكثر", bodyLength >= 350);

  if (source.supportsUpdatedDate) {
    addCheck(6, Boolean(source.updatedDate), "أضف تاريخ آخر تحديث");
  }

  if (source.supportsFaq) {
    addCheck(6, Boolean(source.faqCount && source.faqCount > 0), "أضف سؤالًا شائعًا واحدًا على الأقل");
  }

  return {
    kind: source.kind,
    title: source.title,
    path: source.path,
    score: possible > 0 ? Math.round((earned / possible) * 100) : 0,
    draft: source.draft,
    warnings,
    seoTitleLength: seoTitle.length,
    descriptionLength: seoDescription.length,
  };
}

const audits: AuditItem[] = [
  ...blogEntries.map((entry) =>
    createAudit({
      kind: "مقال",
      title: entry.data.title,
      description: entry.data.description,
      seoTitle: entry.data.seoTitle,
      seoDescription: entry.data.seoDescription,
      image: entry.data.image,
      imageAlt: entry.data.imageAlt,
      terms: entry.data.tags,
      body: bodyOf(entry),
      updatedDate: entry.data.updatedDate,
      faqCount: entry.data.faq.length,
      draft: entry.data.draft,
      path: `/blog/${entry.id}/`,
      supportsUpdatedDate: true,
      supportsFaq: true,
    }),
  ),
  ...serviceEntries.map((entry) =>
    createAudit({
      kind: "خدمة",
      title: entry.data.title,
      description: entry.data.description,
      seoTitle: entry.data.seoTitle,
      seoDescription: entry.data.seoDescription,
      image: entry.data.image,
      imageAlt: entry.data.imageAlt,
      terms: entry.data.keywords,
      body: bodyOf(entry),
      updatedDate: entry.data.updatedDate,
      faqCount: entry.data.faq.length,
      draft: entry.data.draft,
      path: `/services/${entry.id}/`,
      supportsUpdatedDate: true,
      supportsFaq: true,
    }),
  ),
  ...projectEntries.map((entry) =>
    createAudit({
      kind: "مشروع",
      title: entry.data.title,
      description: entry.data.description,
      seoTitle: entry.data.seoTitle,
      seoDescription: entry.data.seoDescription,
      image: entry.data.coverImage,
      imageAlt: entry.data.coverImageAlt,
      terms: entry.data.services,
      body: bodyOf(entry),
      draft: entry.data.draft,
      path: `/projects/${entry.id}/`,
    }),
  ),
].sort((a, b) => a.score - b.score || a.title.localeCompare(b.title, "ar"));

const publishedCount = audits.filter((item) => !item.draft).length;
const draftCount = audits.filter((item) => item.draft).length;
const needsReviewCount = audits.filter((item) => !item.draft && item.score < 80).length;
const averageScore = audits.length
  ? Math.round(audits.reduce((total, item) => total + item.score, 0) / audits.length)
  : 0;

const searchConsoleUrl = new URL("https://search.google.com/search-console");
searchConsoleUrl.searchParams.set("resource_id", `sc-domain:${hostname}`);
const pageSpeedUrl = new URL("https://pagespeed.web.dev/");
pageSpeedUrl.searchParams.set("url", `${productionUrl}/`);
const richResultsUrl = new URL("https://search.google.com/test/rich-results");
richResultsUrl.searchParams.set("url", `${productionUrl}/`);

const scoreClass = (score: number) => {
  if (score >= 85) return "excellent";
  if (score >= 70) return "good";
  return "review";
};
---

<SeoAdminLayout
  title={`لوحة إدارة السيو | ${settings.siteName}`}
  description="مراجعة داخلية لمحتوى الموقع وخريطة الموقع وملف robots والبيانات المنظمة."
>
  <main id="seo-admin-main" class="seo-dashboard" data-site-url={productionUrl}>
    <header class="dashboard-header">
      <div>
        <span class="eyebrow">لوحة داخلية — غير مفهرسة</span>
        <h1>إدارة السيو والفهرسة</h1>
        <p>
          فحص المحتوى وإعدادات الزحف والبيانات المنظمة لموقع
          <strong>{settings.siteName}</strong>.
        </p>
      </div>

      <nav class="header-actions" aria-label="روابط الإدارة">
        <a class="button button-secondary" href="/admin/">إدارة المحتوى</a>
        <a class="button button-primary" href="/" target="_blank" rel="noopener noreferrer">
          فتح الموقع
        </a>
      </nav>
    </header>

    <section class="summary-grid" aria-label="ملخص السيو">
      <article class="summary-card">
        <span>المحتوى المنشور</span>
        <strong>{publishedCount}</strong>
        <small>مقال وخدمة ومشروع</small>
      </article>

      <article class="summary-card">
        <span>متوسط نتيجة الفحص</span>
        <strong>{averageScore}%</strong>
        <small>فحص داخلي إرشادي</small>
      </article>

      <article class="summary-card">
        <span>بحاجة إلى مراجعة</span>
        <strong>{needsReviewCount}</strong>
        <small>نتيجتها أقل من 80%</small>
      </article>

      <article class="summary-card">
        <span>المسودات</span>
        <strong>{draftCount}</strong>
        <small>لا تظهر في Sitemap</small>
      </article>
    </section>

    <section class="dashboard-panel" aria-labelledby="live-checks-title">
      <div class="panel-heading">
        <div>
          <span class="eyebrow">فحص مباشر</span>
          <h2 id="live-checks-title">حالة الأرشفة التقنية</h2>
          <p>يُجرى الفحص من المتصفح على النسخة المنشورة للموقع.</p>
        </div>

        <button class="button button-secondary" type="button" data-run-live-checks>
          إعادة الفحص
        </button>
      </div>

      <div class="live-grid" aria-live="polite">
        <article class="live-card is-loading" data-live-check="robots">
          <span class="live-indicator" aria-hidden="true"></span>
          <div>
            <strong>robots.txt</strong>
            <p data-live-message>جارٍ الفحص…</p>
            <small data-live-detail></small>
          </div>
        </article>

        <article class="live-card is-loading" data-live-check="sitemap">
          <span class="live-indicator" aria-hidden="true"></span>
          <div>
            <strong>Sitemap</strong>
            <p data-live-message>جارٍ الفحص…</p>
            <small data-live-detail></small>
          </div>
        </article>

        <article class="live-card is-loading" data-live-check="canonical">
          <span class="live-indicator" aria-hidden="true"></span>
          <div>
            <strong>Canonical</strong>
            <p data-live-message>جارٍ الفحص…</p>
            <small data-live-detail></small>
          </div>
        </article>

        <article class="live-card is-loading" data-live-check="schema">
          <span class="live-indicator" aria-hidden="true"></span>
          <div>
            <strong>Schema JSON-LD</strong>
            <p data-live-message>جارٍ الفحص…</p>
            <small data-live-detail></small>
          </div>
        </article>
      </div>
    </section>

    <section class="dashboard-panel" aria-labelledby="content-audit-title">
      <div class="panel-heading panel-heading-wrap">
        <div>
          <span class="eyebrow">المحتوى</span>
          <h2 id="content-audit-title">مراجعة المقالات والخدمات والمشاريع</h2>
          <p>النتيجة لا تمثل تقييم Google؛ بل قائمة تحقق داخلية قبل النشر.</p>
        </div>

        <div class="filters" aria-label="تصفية المحتوى">
          <label>
            <span>بحث</span>
            <input type="search" placeholder="اكتب اسم الصفحة…" data-audit-search />
          </label>

          <label>
            <span>النوع</span>
            <select data-audit-kind>
              <option value="all">الكل</option>
              <option value="مقال">المقالات</option>
              <option value="خدمة">الخدمات</option>
              <option value="مشروع">المشاريع</option>
            </select>
          </label>

          <label>
            <span>الحالة</span>
            <select data-audit-status>
              <option value="all">الكل</option>
              <option value="review">بحاجة إلى مراجعة</option>
              <option value="published">منشور</option>
              <option value="draft">مسودة</option>
            </select>
          </label>
        </div>
      </div>

      <p class="results-status" data-audit-results>
        عدد العناصر: {audits.length}
      </p>

      <div class="audit-table-wrap">
        <table class="audit-table">
          <thead>
            <tr>
              <th>الصفحة</th>
              <th>النوع</th>
              <th>النتيجة</th>
              <th>طول العنوان</th>
              <th>طول الوصف</th>
              <th>الملاحظات</th>
              <th>الرابط</th>
            </tr>
          </thead>
          <tbody>
            {
              audits.map((item) => (
                <tr
                  data-audit-row
                  data-title={item.title.toLocaleLowerCase("ar")}
                  data-kind={item.kind}
                  data-score={item.score}
                  data-draft={String(item.draft)}
                >
                  <td>
                    <strong>{item.title}</strong>
                    <small>{item.draft ? "مسودة" : "منشور"}</small>
                  </td>
                  <td><span class="type-badge">{item.kind}</span></td>
                  <td>
                    <span class:list={["score-badge", scoreClass(item.score)]}>
                      {item.score}%
                    </span>
                  </td>
                  <td>{item.seoTitleLength}</td>
                  <td>{item.descriptionLength}</td>
                  <td>
                    {
                      item.warnings.length > 0 ? (
                        <details>
                          <summary>{item.warnings.length} ملاحظة</summary>
                          <ul>
                            {item.warnings.map((warning) => <li>{warning}</li>)}
                          </ul>
                        </details>
                      ) : (
                        <span class="all-good">مكتمل</span>
                      )
                    }
                  </td>
                  <td>
                    {
                      item.draft ? (
                        <span class="muted">غير منشور</span>
                      ) : (
                        <a class="row-link" href={item.path} target="_blank" rel="noopener noreferrer">
                          فتح
                        </a>
                      )
                    }
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section class="dashboard-panel" aria-labelledby="tools-title">
      <div class="panel-heading">
        <div>
          <span class="eyebrow">أدوات خارجية</span>
          <h2 id="tools-title">التحقق والمتابعة</h2>
          <p>تفتح الأدوات في نافذة جديدة باستخدام الدومين الحالي.</p>
        </div>
      </div>

      <div class="tools-grid">
        <a href={searchConsoleUrl.toString()} target="_blank" rel="noopener noreferrer">
          <strong>Google Search Console</strong>
          <span>الصفحات والفهرسة وطلبات البحث</span>
        </a>
        <a href={pageSpeedUrl.toString()} target="_blank" rel="noopener noreferrer">
          <strong>PageSpeed Insights</strong>
          <span>الأداء ومؤشرات الويب الأساسية</span>
        </a>
        <a href={richResultsUrl.toString()} target="_blank" rel="noopener noreferrer">
          <strong>اختبار النتائج المنسقة</strong>
          <span>فحص بيانات Schema</span>
        </a>
        <a href="/sitemap-index.xml" target="_blank" rel="noopener noreferrer">
          <strong>خريطة الموقع</strong>
          <span>/sitemap-index.xml</span>
        </a>
        <a href="/robots.txt" target="_blank" rel="noopener noreferrer">
          <strong>ملف robots.txt</strong>
          <span>قواعد الزحف الحالية</span>
        </a>
        <a href="/admin/">
          <strong>Decap CMS</strong>
          <span>تعديل المحتوى وحقول SEO</span>
        </a>
      </div>
    </section>

    <footer class="dashboard-footer">
      <span>الدومين المستخدم في البناء:</span>
      <code>{productionUrl}</code>
    </footer>
  </main>
</SeoAdminLayout>

<script>
  type LiveState = "loading" | "success" | "warning" | "error";

  const dashboard = document.querySelector<HTMLElement>("[data-site-url]");
  const siteUrl = dashboard?.dataset.siteUrl?.replace(/\/+$/, "") || window.location.origin;

  function setLiveStatus(
    name: string,
    state: LiveState,
    message: string,
    detail = "",
  ) {
    const card = document.querySelector<HTMLElement>(`[data-live-check="${name}"]`);
    if (!card) return;

    card.classList.remove("is-loading", "is-success", "is-warning", "is-error");
    card.classList.add(`is-${state}`);

    const messageElement = card.querySelector<HTMLElement>("[data-live-message]");
    const detailElement = card.querySelector<HTMLElement>("[data-live-detail]");
    if (messageElement) messageElement.textContent = message;
    if (detailElement) detailElement.textContent = detail;
  }

  async function fetchText(path: string) {
    const response = await fetch(path, { cache: "no-store" });
    if (!response.ok) throw new Error(`${response.status} ${response.statusText}`);
    return response.text();
  }

  async function countSitemapUrls(xmlText: string) {
    const parser = new DOMParser();
    const documentXml = parser.parseFromString(xmlText, "application/xml");
    const parseError = documentXml.querySelector("parsererror");
    if (parseError) throw new Error("تعذر قراءة XML");

    const directUrls = documentXml.querySelectorAll("url > loc");
    if (directUrls.length > 0) return directUrls.length;

    const sitemapLocations = Array.from(documentXml.querySelectorAll("sitemap > loc"))
      .map((element) => element.textContent?.trim())
      .filter((value): value is string => Boolean(value));

    if (sitemapLocations.length === 0) return 0;

    const childCounts = await Promise.all(
      sitemapLocations.map(async (location) => {
        const childUrl = new URL(location, siteUrl);
        if (childUrl.origin !== window.location.origin) return 0;
        const childXml = await fetchText(`${childUrl.pathname}${childUrl.search}`);
        const childDocument = parser.parseFromString(childXml, "application/xml");
        return childDocument.querySelectorAll("url > loc").length;
      }),
    );

    return childCounts.reduce((total, count) => total + count, 0);
  }

  async function runLiveChecks() {
    ["robots", "sitemap", "canonical", "schema"].forEach((name) => {
      setLiveStatus(name, "loading", "جارٍ الفحص…");
    });

    try {
      const robotsText = await fetchText("/robots.txt");
      const hasSitemap = /Sitemap:\s*https?:\/\//iu.test(robotsText);
      const blocksAdmin = /Disallow:\s*\/admin\//iu.test(robotsText);
      const blocksSeoAdmin = /Disallow:\s*\/seo-admin\//iu.test(robotsText);

      if (hasSitemap && blocksAdmin && blocksSeoAdmin) {
        setLiveStatus("robots", "success", "سليم", "يسمح بالموقع ويستبعد لوحات الإدارة");
      } else {
        const missing = [
          !hasSitemap && "رابط Sitemap",
          !blocksAdmin && "حظر /admin/",
          !blocksSeoAdmin && "حظر /seo-admin/",
        ].filter(Boolean).join("، ");
        setLiveStatus("robots", "warning", "يحتاج مراجعة", `ناقص: ${missing}`);
      }
    } catch (error) {
      setLiveStatus("robots", "error", "تعذر الوصول", error instanceof Error ? error.message : "خطأ غير معروف");
    }

    try {
      const sitemapText = await fetchText("/sitemap-index.xml");
      const urlCount = await countSitemapUrls(sitemapText);
      setLiveStatus(
        "sitemap",
        urlCount > 0 ? "success" : "warning",
        urlCount > 0 ? "الخريطة تعمل" : "لم تُكتشف روابط",
        `${urlCount} عنوان URL مكتشف`,
      );
    } catch (error) {
      setLiveStatus("sitemap", "error", "تعذر قراءة الخريطة", error instanceof Error ? error.message : "خطأ غير معروف");
    }

    try {
      const homeHtml = await fetchText("/");
      const htmlDocument = new DOMParser().parseFromString(homeHtml, "text/html");
      const canonical = htmlDocument.querySelector<HTMLLinkElement>('link[rel="canonical"]')?.href;
      const expected = `${siteUrl}/`;

      if (canonical && canonical === expected) {
        setLiveStatus("canonical", "success", "صحيح", canonical);
      } else if (canonical) {
        setLiveStatus("canonical", "warning", "مختلف عن الدومين الحالي", canonical);
      } else {
        setLiveStatus("canonical", "error", "غير موجود", "الصفحة الرئيسية بلا canonical");
      }

      const schemaBlocks = Array.from(
        htmlDocument.querySelectorAll<HTMLScriptElement>('script[type="application/ld+json"]'),
      );
      let validBlocks = 0;
      schemaBlocks.forEach((block) => {
        try {
          JSON.parse(block.textContent || "");
          validBlocks += 1;
        } catch {
          // تُعرض النتيجة الإجمالية أدناه.
        }
      });

      if (validBlocks > 0 && validBlocks === schemaBlocks.length) {
        setLiveStatus("schema", "success", "JSON-LD صالح", `${validBlocks} كتلة بيانات منظمة`);
      } else if (schemaBlocks.length > 0) {
        setLiveStatus("schema", "warning", "بعض الكتل تحتاج مراجعة", `${validBlocks} من ${schemaBlocks.length} صالحة`);
      } else {
        setLiveStatus("schema", "error", "غير موجود", "لم تُكتشف بيانات منظمة");
      }
    } catch (error) {
      const detail = error instanceof Error ? error.message : "خطأ غير معروف";
      setLiveStatus("canonical", "error", "تعذر فحص الصفحة", detail);
      setLiveStatus("schema", "error", "تعذر فحص الصفحة", detail);
    }
  }

  const auditRows = Array.from(document.querySelectorAll<HTMLElement>("[data-audit-row]"));
  const searchInput = document.querySelector<HTMLInputElement>("[data-audit-search]");
  const kindSelect = document.querySelector<HTMLSelectElement>("[data-audit-kind]");
  const statusSelect = document.querySelector<HTMLSelectElement>("[data-audit-status]");
  const resultsElement = document.querySelector<HTMLElement>("[data-audit-results]");

  function filterAuditRows() {
    const query = (searchInput?.value || "").toLocaleLowerCase("ar").trim();
    const kind = kindSelect?.value || "all";
    const status = statusSelect?.value || "all";
    let visibleCount = 0;

    auditRows.forEach((row) => {
      const title = row.dataset.title || "";
      const rowKind = row.dataset.kind || "";
      const score = Number(row.dataset.score || 0);
      const draft = row.dataset.draft === "true";

      const matchesQuery = !query || title.includes(query);
      const matchesKind = kind === "all" || rowKind === kind;
      const matchesStatus =
        status === "all" ||
        (status === "review" && !draft && score < 80) ||
        (status === "published" && !draft) ||
        (status === "draft" && draft);

      const visible = matchesQuery && matchesKind && matchesStatus;
      row.hidden = !visible;
      if (visible) visibleCount += 1;
    });

    if (resultsElement) resultsElement.textContent = `عدد النتائج: ${visibleCount}`;
  }

  searchInput?.addEventListener("input", filterAuditRows);
  kindSelect?.addEventListener("change", filterAuditRows);
  statusSelect?.addEventListener("change", filterAuditRows);
  document.querySelector("[data-run-live-checks]")?.addEventListener("click", runLiveChecks);

  runLiveChecks();
</script>

<style>
  .seo-dashboard {
    width: min(100% - 2rem, 1380px);
    margin-inline: auto;
    padding-block: 2rem 4rem;
  }

  .dashboard-header,
  .panel-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .dashboard-header {
    margin-bottom: 1.5rem;
    padding: clamp(1.35rem, 4vw, 2.25rem);
    border: 1px solid #e2e5e9;
    border-radius: 1.25rem;
    background: #fff;
  }

  .dashboard-header h1 {
    margin-block: .4rem .55rem;
    font-size: clamp(2rem, 5vw, 3.35rem);
  }

  .dashboard-header p,
